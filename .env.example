# DocketDrift environment template.
# Copy to `.env` locally for dev, or to /home/private/.env on the NFSN site
# for production. NEVER commit the real `.env`.

# --- Django -----------------------------------------------------------------
# Generate a fresh production SECRET_KEY before deploying:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
# Comma-separated. Use a leading dot for wildcard subdomains (e.g. .docketdrift.com).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,docketdrift.com,.docketdrift.com

# --- Database ---------------------------------------------------------------
# 'sqlite' (default, local dev) or 'mariadb' (production on NFSN).
DOCKETDRIFT_DB=sqlite

# Only used when DOCKETDRIFT_DB=mariadb.
DOCKETDRIFT_DB_HOST=madmaster.db
DOCKETDRIFT_DB_NAME=docketdrift
DOCKETDRIFT_DB_USER=docketdrift_app
DOCKETDRIFT_DB_PASSWORD=

# --- CourtListener ----------------------------------------------------------
# Free token at https://www.courtlistener.com/profile/api-token/ .
COURTLISTENER_TOKEN=

# Ko-fi link for the /support/ page "Chip in" button. OPTIONAL -- but if
# unset the button VANISHES SILENTLY (the template guards on it), which is
# how it went missing unnoticed until 2026-08-06. If you rebuild .env, keep it.
DONATE_URL=https://ko-fi.com/onionmadder

# Bing Webmaster Tools ownership token (served at /BingSiteAuth.xml).
# Get it from the BingSiteAuth.xml that Bing offers on the Add-a-site
# screen: it is the value inside <user>...</user>. If this goes missing
# the file 404s and Bing silently UN-VERIFIES every subdomain.
BING_SITE_AUTH_TOKEN=

# IndexNow key (served at /indexnow-key.txt; sent by `indexnow_ping`,
# which cron-ingest.sh runs only when this is set). Any 8-128 chars of
# [A-Za-z0-9-]; generate one with: python -c "import uuid;print(uuid.uuid4().hex)"
INDEXNOW_KEY=
